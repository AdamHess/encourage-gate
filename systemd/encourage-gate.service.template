# systemd user-service template for encourage-gate.
# Install (per-user, no sudo):
#   mkdir -p ~/.config/systemd/user
#   sed "s|PROJECT_DIR|$PWD|g" systemd/encourage-gate.service.template \
#     > ~/.config/systemd/user/encourage-gate.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now encourage-gate.service
#
# Logs:  journalctl --user -u encourage-gate.service -f
# Stop:  systemctl --user stop encourage-gate.service

[Unit]
Description=encourage-gate prompt rewriter
After=network.target

[Service]
Type=simple
WorkingDirectory=PROJECT_DIR
EnvironmentFile=-PROJECT_DIR/.env
ExecStart=PROJECT_DIR/.venv/bin/encourage-gate-server
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
