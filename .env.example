# Copy to .env and edit. Loaded automatically by encourage-gate-server.

# LLM model (any LiteLLM-supported provider).
ENCOURAGE_GATE_MODEL=anthropic/claude-haiku-4-5

# Provider API key (set the matching one for your chosen model).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# Optional overrides.
# ENCOURAGE_GATE_SOCKET_PATH=/tmp/encourage-gate.sock
# ENCOURAGE_GATE_LOG=INFO
# ENCOURAGE_GATE_REWRITE_TIMEOUT_SECONDS=10
# ENCOURAGE_GATE_MAX_REQUEST_BYTES=65536
